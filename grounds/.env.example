# ==============================================================================
# Grounds - Environment Configuration
# ==============================================================================
# Copy this file to '.env' in the same directory and fill in your details:
# cp .env.example .env
#
# The grounds reads these on the way up. Anything already exported in the shell
# wins over what is written here, so one `export ARENA_SERVICE_TOKEN=...` can
# still cover the arena, the game, the dugout and this at once.
# ==============================================================================

# Which arena to play for. Both the control socket and the page come from here,
# so this is the only address this service needs. Deployed, it is the arena's
# Cloud Run URL.
# ARENA_URL=http://localhost:8003

# [REQUIRED] The shared secret carried in X-Arena-Service, the same value the
# arena and the game's specialists use. Without it the control socket is closed
# with 4403 and this instance retries against a token that will never work.
# What comes back down that socket is a room's physics token, which is why it is
# a server credential and never something a browser holds.
ARENA_SERVICE_TOKEN=dev-token

# How many matches one instance offers to run. This is a promise about CPU, not
# about memory: past it, kick-off is refused with a 503 rather than every match
# in progress slowing down together. Measure it on the machine size you deploy
# (see the plan's capacity task) rather than guessing upwards.
# GROUNDS_CAPACITY=12

# What the health check listens on. Cloud Run sets this itself.
# PORT=8004
