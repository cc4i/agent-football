# ==============================================================================
# Google Agent Development Kit Workshop - Environment Configuration
# ==============================================================================
# Copy this file to '.env' in the same directory and fill in your details:
# cp .env.example .env
# ==============================================================================
GOOGLE_GENAI_USE_VERTEXAI=true

# [REQUIRED] Your Google Cloud Project ID
# This is required to authenticate with Vertex AI.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# [REQUIRED] The image model used to generate the spritesheets
# (gemini-3.1-flash-image) is only served from the 'global' location.
# Pointing this at a regional endpoint such as us-central1 returns a 404.
GOOGLE_CLOUD_LOCATION=global

# [OPTIONAL] Gemini Developer API Key
# If you prefer to use the Gemini Developer API instead of Vertex AI,
# comment out GOOGLE_CLOUD_PROJECT and set your API key here.
# GEMINI_API_KEY=your-gemini-api-key

# [OPTIONAL] The one directory the agent is allowed to write in. Unset it is
# ~/.dugout/workspace. Stage 2 has the agent writing a Playwright script and
# running it, and this is where that script lands. It must be outside this
# repository: create_file and edit_file are denied anywhere inside the repo, so
# pointing this back at the checkout is refused at startup.
# DUGOUT_SCRATCH_DIR=~/.dugout/workspace

# [OPTIONAL] Where the arena is. Every tool in the dugout goes through it, and
# the header's arena dot is this URL answering /health. Unset it is
# http://127.0.0.1:8003, which is the arena you started with arena/run.sh.
# Point it at the deployed service to drive that one from this laptop; the
# dugout itself is not deployed, because it runs shell commands unrestricted.
# ARENA_URL=https://arena-xxxxxxxxxx.europe-west1.run.app
