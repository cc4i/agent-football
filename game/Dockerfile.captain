# The A2A captain. Reached only by the coach, over the loopback interface the
# containers of one Cloud Run instance share.
#
#   docker build -f game/Dockerfile.captain -t captain .

FROM python:3.14-slim
WORKDIR /app

# Pinned, because a lockfile is only as reproducible as the thing reading it:
# `uv sync --frozen` fixes every dependency and a floating uv would leave the
# tool doing the pinning as the one part of the image free to drift.
COPY --from=ghcr.io/astral-sh/uv:0.11.23 /uv /usr/local/bin/uv

COPY game/pyproject.toml game/uv.lock ./
RUN uv sync --frozen --no-dev

COPY game/agents/ ./agents/

# Two addresses, because they answer two different questions.
#
# CAPTAIN_HOST is the one the coach dials. It goes into the agent card's
# rpc_url, which is where `RemoteA2aAgent` sends every request after fetching
# the card, so it has to be connectable: the loopback the instance's containers
# share, and the literal rather than the name captain_server.py defaults to.
# `localhost` would be two addresses in a dual-stack container, which leaves
# this and the dial in game/agents/agent.py agreeing by resolution order.
#
# CAPTAIN_BIND is the interface uvicorn listens on, and it is wide because
# Cloud Run's startup probe does not dial from inside the instance's network
# namespace. Bound to the loopback this container was unreachable to the probe
# while serving perfectly well - see deploy/README.md. Nothing is published by
# widening it: this container declares no port to Cloud Run, so no external
# request is ever routed here.
ENV CAPTAIN_HOST=127.0.0.1 \
    CAPTAIN_BIND=0.0.0.0 \
    CAPTAIN_PORT=8001 \
    PATH="/app/.venv/bin:$PATH"

EXPOSE 8001

CMD ["python", "-m", "agents.captain_server"]
