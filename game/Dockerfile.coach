# The ADK coach. Nothing authenticates a request to an ADK server, so it is
# reachable only from the instance it runs in.
#
#   docker build -f game/Dockerfile.coach -t coach .

FROM python:3.14-slim
WORKDIR /app

# Pinned, because a lockfile is only as reproducible as the thing reading it:
# `uv sync --frozen` fixes every dependency and a floating uv would leave the
# tool doing the pinning as the one part of the image free to drift.
COPY --from=ghcr.io/astral-sh/uv:0.11.23 /uv /usr/local/bin/uv

COPY game/pyproject.toml game/uv.lock ./
RUN uv sync --frozen --no-dev

COPY game/agents/ ./agents/

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

# `adk web .` scans the working directory for the agent package beside it.
#
# Wide, because Cloud Run's startup probe does not dial from inside the
# instance's network namespace: the captain bound the loopback and was
# unreachable to its probe while serving perfectly well, and this container has
# the same tcpSocket probe against it. See deploy/README.md.
#
# The isolation is unchanged, and it was never the bind. This container
# declares no port to Cloud Run, so no external request is routed to it -
# external traffic reaches the ingress container alone, and Direct VPC egress
# is egress, so nothing in the VPC can dial an instance either.
#
# The arena still dials 127.0.0.1:8000, which this bind covers. It stays a
# literal there: `localhost` is two addresses in a dual-stack container, and
# 0.0.0.0 is not IPv6, so a name dial would reach ::1 first and be refused.
CMD ["adk", "web", ".", "--host", "0.0.0.0", "--port", "8000"]
